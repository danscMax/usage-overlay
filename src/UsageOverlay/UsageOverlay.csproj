<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\UsageOverlay.ico</ApplicationIcon>
    <AssemblyName>UsageOverlay</AssemblyName>
    <RootNamespace>UsageOverlay</RootNamespace>
    <Product>Usage Overlay</Product>
    <AssemblyTitle>Usage Overlay</AssemblyTitle>
    <Description>Usage limits and workspace status for Codex, Claude and Cursor. Maintained in the danscMax fork.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <StartupObject>UsageOverlay.Program</StartupObject>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexUsage.Core\CodexUsage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\UsageOverlay.ico" />
    <Resource Include="Assets\Logos\*.png" />
    <Resource Include="Assets\Statusline\StatuslineIcons.ttf" />
    <EmbeddedResource Include="Telemetry\LICENSE.codex-statusbar.txt" />
    <EmbeddedResource Include="Assets\Statusline\LICENSE.txt" />
  </ItemGroup>
</Project>
